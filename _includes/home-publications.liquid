{% assign current_lang = page.lang | default: site.lang %}
{% assign strings = site.data.i18n[current_lang] %}
{% capture publication_list %}{% bibliography -f publications --template publication %}{% endcapture %}
<div class="home-publications">
  {% if publication_list contains 'publication-entry' -%}
    {{- publication_list -}}
  {%- else %}
    <p>{{ strings.content.empty_publications }}</p>
  {% endif %}
</div>
