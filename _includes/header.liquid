{% assign current_lang = page.lang | default: site.lang %}
{% assign strings = site.data.i18n[current_lang] %}
{% assign translated_content = site.pages | concat: site.projects | concat: site.posts | where: 'translation_key', page.translation_key %}
{% assign counterpart = translated_content | where: 'lang', strings.other_lang | first %}

<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-site-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ strings.ui.navigation }}"
      >
        <span class="sr-only">{{ strings.ui.navigation }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <li class="nav-item {% if page.url == strings.home %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ strings.home | relative_url }}"
              {% if page.url == strings.home %}
                aria-current="page"
              {% endif %}
            >
              {{- strings.nav.about -}}
            </a>
          </li>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign nav_lang = p.lang | default: site.lang %}
            {% if p.nav and p.autogen == null and nav_lang == current_lang %}
              <li class="nav-item {% if page.url contains p.url %}active{% endif %}">
                <a
                  class="nav-link"
                  href="{{ p.url | relative_url }}"
                  {% if page.url == p.url %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- p.title -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
          {% if counterpart or site.enable_darkmode %}
            <li class="toggle-container nav-tools">
              {% if counterpart %}
                <a
                  class="site-nav-tool language-switch"
                  data-language-switch
                  href="{{ counterpart.url | relative_url }}"
                  lang="{{ strings.other_lang }}"
                  hreflang="{{ strings.other_lang }}"
                  title="{{ strings.switch_title }}"
                  aria-label="{{ strings.switch_title }}"
                >
                  <svg
                    class="site-nav-icon site-language-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M3 5h11M8 2v3M12 5c-1 5-4 9-9 11M5 8c1.5 3.5 4 6 7 8" />
                    <path d="m13 21 4-10 4 10m-6.5-4h5" />
                  </svg>
                </a>
              {% endif %}
              {% if site.enable_darkmode %}
                <button
                  id="light-toggle"
                  class="site-nav-tool"
                  type="button"
                  title="{{ strings.ui.theme }}"
                  aria-label="{{ strings.ui.theme }}"
                  data-light-label="{{ strings.ui.light_theme }}"
                  data-dark-label="{{ strings.ui.dark_theme }}"
                >
                  <svg
                    class="site-nav-icon site-theme-icon"
                    data-theme-icon="dark"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <path d="M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z" />
                  </svg>
                  <svg
                    class="site-nav-icon site-theme-icon"
                    data-theme-icon="light"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                  </svg>
                </button>
              {% endif %}
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
