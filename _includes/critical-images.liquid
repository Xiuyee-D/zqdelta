{% assign image_lang = page.lang | default: site.lang %}
{% assign image_profile = site.pages | where: 'translation_key', 'about' | where: 'lang', image_lang | first %}
{% if image_profile.profile.image %}
  {% assign image_path = image_profile.profile.image | prepend: '/assets/img/' %}
  {% assign image_extension = image_path | split: '.' | last %}
  {% assign raster_extensions = 'png,jpg,jpeg,tiff,gif' | split: ',' %}
  {% if site.imagemagick.enabled and raster_extensions contains image_extension %}
    {% assign image_stem = image_path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
    {% capture image_srcset %}{% for width in site.imagemagick.widths %}{{ image_stem | relative_url }}-{{ width }}.webp {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}{% endcapture %}
    <link
      rel="preload"
      as="image"
      href="{{ image_stem | relative_url }}-{{ site.imagemagick.widths.first }}.webp"
      imagesrcset="{{ image_srcset | strip }}"
      imagesizes="(min-width: 925px) 175px, 75px"
      type="image/webp"
      fetchpriority="high"
    >
  {% else %}
    <link rel="preload" as="image" href="{{ image_path | relative_url | bust_file_cache }}" fetchpriority="high">
  {% endif %}
{% endif %}
{% if page.translation_key == 'blog' %}
  {% assign cover_posts = site.posts | where: 'lang', image_lang | sort: 'date' | reverse | where_exp: 'post', 'post.cover' %}
  {% for post in cover_posts limit: 2 %}
    <link rel="preload" as="image" href="{{ post.cover | relative_url }}">
  {% endfor %}
{% endif %}
