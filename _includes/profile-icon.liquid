        <circle cx="6.5" cy="6.5" r="1.1" />
        <path d="M5.6 9h1.8v9H5.6V9Z" />
        <path fill-rule="evenodd" d="M10 6h4a6 6 0 0 1 0 12h-4V6Zm1.8 1.8v8.4H14a4.2 4.2 0 0 0 0-8.4h-2.2Z" />
