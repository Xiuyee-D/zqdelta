        <circle cx="7" cy="7" r="1.5" />
        <path d="M5.7 10h2.6v8H5.7v-8Zm5 0h2.5v1.1c.7-.9 1.6-1.4 2.7-1.4 2.1 0 3.1 1.4 3.1 3.7V18h-2.6v-4.2c0-1.4-.5-2-1.5-2-1.1 0-1.6.8-1.6 2.2v4h-2.6v-8Z" />
