<script src="{{ '/assets/js/nav-toggle.js' | relative_url | bust_file_cache }}"></script>
{% comment %}Kramdown emits these delimiters from the shared Markdown; no duplicated math flags per language.{% endcomment %}
{% if site.enable_math and site.plugins contains 'al_math' %}
  {% if content contains '\(' or content contains '\[' %}
    {% include plugins/al_math_scripts.liquid %}
  {% endif %}
{% endif %}
<script src="{{ '/assets/js/no_defer.js' | relative_url | bust_file_cache }}"></script>
{% if content contains '<pre' %}
  <script defer src="{{ '/assets/js/site-code.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if page.lang == 'en' %}
  {% if page.translation_key == 'projects' or page.translation_key == 'blog' %}
    <script defer src="{{ '/assets/js/site-summaries.js' | relative_url | bust_file_cache }}"></script>
  {% endif %}
{% endif %}
{% if site.enable_progressbar %}
  <script defer src="{{ '/assets/js/progress-bar.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if site.back_to_top %}
  <script
    defer
    src="{{ site.third_party_libraries['vanilla-back-to-top'].url.js | relative_url | bust_file_cache }}"
    integrity="{{ site.third_party_libraries['vanilla-back-to-top'].integrity.js }}"
    crossorigin="anonymous"
  ></script>
{% endif %}
